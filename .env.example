# ==== Dexter Cyber configuration ====
# Copy this file to ".env" and fill in your values.

# Your OpenRouter API key (get a free one at https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Free models on OpenRouter (the ":free" variants cost nothing).
# Text / reasoning brain:
DEXTER_TEXT_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Vision model (used when Dexter needs to "see" the screen):
DEXTER_VISION_MODEL=google/gemini-2.0-flash-exp:free

# Where Dexter stores consent, memory and logs (defaults to ~/.dexter_cyber)
# DEXTER_HOME=

# Local web UI host / port
DEXTER_HOST=127.0.0.1
DEXTER_PORT=8787

# Voice output on/off (1/0)
DEXTER_VOICE=1
# Preferred TTS voice name substring (optional, OS-dependent)
DEXTER_VOICE_NAME=
# Words per minute for the voice
DEXTER_VOICE_RATE=175
